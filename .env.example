# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Your own Discord user ID (Developer Mode > right-click yourself > Copy User ID)
OWNER_ID=
# elevenlabs.io > Developers > API Keys
ELEVENLABS_API_KEY=
# Optional: ElevenLabs voice ID (DM the bot !voices to list them). Default is the stock voice "George".
VOICE_ID=
